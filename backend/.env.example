# uat or prod. Each environment needs its own service account.
UNICO_ENV=uat
# The `iss` from your credentials: <account_name>@<tenant_id>.iam.acesso.io
UNICO_SERVICE_ACCOUNT=
# Path to the .pem private key. Keep it outside the repository.
UNICO_PRIVATE_KEY_PATH=
# Origin of the web app allowed to call this backend.
ALLOWED_ORIGIN=http://localhost:8080
PORT=3000
