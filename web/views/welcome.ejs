<%- include('partials/head', { title: 'Welcome' }) %>
<div class="welcome">
<h1>See how a Unico integration works</h1>
<p class="hint">Run a real flow in <%= env.toUpperCase() %>. You get the request your backend sends and the result that comes back.</p>

<p class="lab">How it works</p>
<ol class="steps">
  <li><b>Your server is the setup</b><span class="hint">The credentials already live in its configuration. Nothing to enter here.</span></li>
  <li><b>Run a flow</b><span class="hint">Type the flow name and the person's document.</span></li>
  <li><b>Read the result</b><span class="hint">See the response, the selfie and the evidence set.</span></li>
</ol>

<p class="lab">Server configuration</p>
<dl class="card rows">
  <% if (!tokenError) { %>
  <div><dt>Status</dt><dd><span class="pill"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" /><path d="M4.2 7.2l2 2 3.6-4" /></svg>Ready</span></dd></div>
  <% } %>
  <div><dt>Service account</dt><dd><code><%= account %></code></dd></div>
  <div><dt>Tenant ID</dt><dd><code><%= tenant %></code></dd></div>
  <div><dt>Environment</dt><dd><code><%= env.toUpperCase() %></code></dd></div>
</dl>
<% if (tokenError) { %>
<div class="card stack">
  <p class="lab">Couldn't get a token</p>
  <pre class="code"><%= tokenError %></pre>
  <p class="hint">Check <code>UNICO_SERVICE_ACCOUNT</code> and the private key in the server's <code>.env</code>, then restart it.</p>
</div>
<% } %>
<p class="hint">Read from your server's <code>.env</code>. The private key never reaches the browser. <a href="https://developer.unico.io/developers/start/authentication">Authentication guide</a></p>

<div class="dock">
  <div class="actions"><a class="button" href="/run">Get started</a></div>
</div>
</div>
<%- include('partials/foot') %>
