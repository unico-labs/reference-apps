# Demo only: the app has no login. Anyone who can reach this server acts with your service account and can
# read any process by its id through the unico_process_id cookie. Run it on localhost or a private network.
# uat or prod. Each environment needs its own service account.
UNICO_ENV=uat
# The `iss` from your credentials: <account_name>@<tenant_id>.iam.acesso.io
UNICO_SERVICE_ACCOUNT=
# Path to the .pem private key. Keep it outside the repository.
UNICO_PRIVATE_KEY_PATH=
# Where browsers reach this app. The callbackUri is built from it, so behind a proxy use the public https address.
PUBLIC_URL=http://localhost:3000
PORT=3000
