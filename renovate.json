{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    { "matchFileNames": ["backend/**"], "additionalBranchPrefix": "backend-" },
    { "matchFileNames": ["web/**"], "additionalBranchPrefix": "web-" },
    { "matchFileNames": ["android/**"], "additionalBranchPrefix": "android-" },
    { "matchFileNames": ["ios/**"], "additionalBranchPrefix": "ios-" },
    { "matchFileNames": ["flutter/**"], "additionalBranchPrefix": "flutter-" }
  ]
}
